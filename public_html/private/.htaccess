# Blocks all direct web access to everything under private/ (uploaded file
# blobs and nightly backups). This directory's contents are only ever
# served through api.php's authenticated GET /_blob/{id} route — never
# directly by Apache — and this rule applies recursively to its
# subdirectories (uploads/, backups/), so no separate .htaccess is needed
# in either of those.

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 and earlier
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
