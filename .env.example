# Copy this file to .env and fill in what you need. Every setting is optional.

# The web address people use to reach the board from outside, without a trailing slash.
# Used for links in email alerts.
BASE_URL=https://board.yourvenue.com

# Port the board listens on inside your network.
PORT=8080

# Set both to true when the board sits behind Cloudflare Tunnel or another HTTPS proxy.
TRUST_PROXY=true
COOKIE_SECURE=true

# Largest file people can upload, in megabytes.
MAX_UPLOAD_MB=25

# Email alerts for @ mentions and task assignments. Leave SMTP_HOST empty to turn them off.
# Any mail service works (Google Workspace, Microsoft 365, Postmark, Mailgun, your web host).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Event Board <board@yourvenue.com>

# The board backs itself up automatically every night (no cron setup needed).
# Hour of the day it runs, in the server's local time, 0-23.
BACKUP_HOUR=3
# How many nightly backups to keep before the oldest are deleted.
BACKUP_KEEP=14

# Optional: turn work order rows from a Google Sheet into Tasks board cards.
# Leave WORKORDER_SHEET_ID empty to turn this off entirely. See the README
# section "Work order sheet sync" for how to create the read-only key file.
# This only ever reads the sheet; it is never given permission to edit it.
WORKORDER_SHEET_ID=
WORKORDER_SHEET_KEY_FILE=./data/secrets/workorder-sheet-readonly.json
WORKORDER_SHEET_RANGE=Sheet2!A1:K5000
WORKORDER_SYNC_MINUTES=15
